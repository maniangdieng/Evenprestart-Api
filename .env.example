# --- App ---
NODE_ENV=development
PORT=3001
API_PREFIX=api
CORS_ORIGIN=http://localhost:3000

# --- Database (matches docker-compose.yml postgres service) ---
DATABASE_URL="postgresql://eventprestart:eventprestart@localhost:5432/eventprestart?schema=public"

# --- Redis / BullMQ ---
REDIS_URL="redis://localhost:6379"

# --- Auth / JWT ---
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

# --- OAuth2 ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# --- Cloudinary (media storage) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Payments ---
WAVE_API_KEY=
ORANGE_MONEY_API_KEY=
FREE_MONEY_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# --- Notifications ---
SENDGRID_API_KEY=
RESEND_API_KEY=
# Brevo (emails transactionnels) — https://app.brevo.com/settings/keys/api
BREVO_API_KEY=
MAIL_FROM=no-reply@eventprestart.sn
MAIL_FROM_NAME=Event Prest'Art
# Logo en tête des emails (URL publique HTTPS). Par défaut : APP_WEB_URL/brand/logo-icon.png
MAIL_LOGO_URL=
# URL publique du front (liens dans les emails). Par défaut : CORS_ORIGIN
APP_WEB_URL=http://localhost:3000
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Monitoring ---
SENTRY_DSN=
